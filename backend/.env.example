APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Midtrans (pembayaran online PPDB) ---------------------------
# Kosongkan SERVER_KEY untuk pengembangan: portal otomatis memakai transfer manual.
# Callback publik selalu menolak notifikasi tanpa tanda tangan SHA-512, kecuali
# ALLOW_UNSIGNED_NOTIFICATIONS=true — nyalakan HANYA untuk uji lokal/mock,
# karena siapa pun bisa melunasi tagihan tanpa kredensial penyedia.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_BASE_URL=
MIDTRANS_ALLOW_UNSIGNED_NOTIFICATIONS=false

# ---------------------------------------------------------------------------
# LMS (Phase 1–5)
# ---------------------------------------------------------------------------
# Mode: false = terintegrasi ERP/SIAKAD (default produksi), true = mandiri.
LMS_STANDALONE=false

# Integrasi nilai akademik: siakad | standalone
LMS_GRADE_PROVIDER=siakad

# Sakelar fitur (dapat diubah dari halaman Pengaturan LMS tanpa deploy)
LMS_CERTIFICATE_ENABLED=true
LMS_GAMIFICATION_ENABLED=true
LMS_LEADERBOARD_ENABLED=false
LMS_LEADERBOARD_DISPLAY=name            # name | initials | anonymized
LMS_STREAK_ENABLED=true
LMS_REVIEW_ENABLED=true
LMS_REVIEW_AUTO_APPROVE=false
LMS_ENGAGEMENT_ENABLED=true

# Kebijakan keuangan (§8) — LMS tidak memuat aturan Finance.
LMS_FINANCE_GATE=false
LMS_ALLOW_LEARNING_WHEN_RESTRICTED=true
LMS_FINANCE_GRACE_DAYS=0

# Antrean & otomatisasi (§11)
LMS_HEALTH_REFRESH_MINUTES=30
LMS_DUE_REMINDER_DAYS=2
LMS_OVERDUE_REMINDER_DAYS=3
LMS_GRADE_SYNC_MAX_ATTEMPTS=5
LMS_GRADE_SYNC_BACKOFF_MINUTES=10
LMS_CERTIFICATE_AUTO_ISSUE=true
LMS_BADGE_AUTO_EVALUATE=true

# Berkas & penyimpanan (§28)
LMS_FILES_DISK=local
LMS_MAX_UPLOAD_MB=25
LMS_TEMP_FILE_HOURS=24

# Laporan (§22) — XLSX/PDF memerlukan pustaka tambahan.
LMS_REPORT_RICH_FORMATS=false
LMS_REPORT_SYNC_LIMIT=500
LMS_REPORT_RETENTION_DAYS=7

# Audit & retensi (§23, §39)
LMS_AUDIT_ENABLED=true
LMS_AUDIT_MIRROR=true
LMS_AUDIT_RETENTION_DAYS=1095
LMS_NOTIFICATION_KEEP_DAYS=180
LMS_ARCHIVE_AFTER_DAYS=365

# Rate limit (§30)
LMS_RL_QUIZ_ATTEMPT=10
LMS_RL_QUIZ_ANSWER=120
LMS_RL_SUBMISSION=20
LMS_RL_FORUM_POST=30
LMS_RL_FILE_UPLOAD=30
LMS_RL_CERT_VERIFY=30
LMS_RL_SEARCH=60
LMS_RL_PUBLIC=120
LMS_RL_SCORM=300
LMS_RL_GRADE_SYNC=60
LMS_RL_NOTIFICATION=60
LMS_RL_LIVE_JOIN=30
LMS_RL_COURSE_IMPORT=10
LMS_RL_REPORT_EXPORT=20

# Provider opsional: isi hanya bila memakai implementasi lain (§4).
# LMS_PARENT_PROVIDER=
# LMS_ENROLLMENT_PROVIDER=
# LMS_NOTIFICATION_PROVIDER=
# LMS_CALENDAR_PROVIDER=
# LMS_FILE_PROVIDER=
# LMS_ATTENDANCE_PROVIDER=
# LMS_FINANCE_PROVIDER=
# LMS_INTERACTIVE_PROVIDER=
